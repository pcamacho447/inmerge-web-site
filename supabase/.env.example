# ============================================================================
# Inmerge Consulting — Supabase Edge Functions & Backend Environment Secrets
# ============================================================================
#
# Este archivo lista los secretos y variables de entorno requeridos para
# el funcionamiento de las Edge Functions en producción:
#   - notify-lead-tdr
#   - notify-deliverable
#   - notify-project-status
#   - secure-download
#
# Para configurar estos secretos en tu proyecto remoto de Supabase:
#   npx supabase secrets set --env-file ./supabase/.env
# O individualmente:
#   npx supabase secrets set ALERT_WEBHOOK_URL="https://..." RESEND_API_KEY="re_..."

# 1. Notificaciones de Webhook (Slack / Discord / n8n / Zapier)
# Recibe alertas instantáneas en canales internos ante nuevos leads TDR,
# entregables publicados o transiciones de fases de proyectos.
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 2. Proveedor de Correo Transaccional (Resend)
# Emisión de acuses de recibo automáticos para leads y avisos de entregables.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# 3. Buzón Institucional y Remitente Oficial
CONSULTING_INBOX=inmerge3@gmail.com
RESEND_FROM=Inmerge Consulting <informes@inmerge.pe>

# 4. Credenciales de Plataforma (Inyectadas automáticamente por Supabase en runtime)
# Solo requeridas para desarrollo o pruebas locales con `supabase start`:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=ey...
# SUPABASE_SERVICE_ROLE_KEY=ey...
