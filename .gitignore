# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp

# Node
node_modules/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*

# Env
.env
.env.*
!.env.example

# Credenciales sueltas. NUNCA commitear: el repo es remoto y publicar una
# contraseña la deja en el historial de git para siempre, aunque se borre
# el archivo después.
contraseña supabase.txt
*contraseña*
*password*.txt
*credenciales*

# Claude Code — machine-local settings (may hold tokens/env overrides).
# .mcp.json is intentionally NOT ignored: it references ${SUPABASE_ACCESS_TOKEN}
# rather than embedding it, so it is safe to commit and share.
.claude/settings.local.json

# Build output
dist/
build/
out/

# Logs
*.log
logs/

# Artefacto del CLI de Supabase. Se crea donde sea que se corra el comando;
# el proyecto real vive en web/app/supabase/. Ignorarlo en cualquier nivel
# evita commitear un linked-project.json suelto por correrlo desde la raiz.
supabase/.temp/
