{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inmerge-web",
  "compatibility_date": "2024-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "single-page-application",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
